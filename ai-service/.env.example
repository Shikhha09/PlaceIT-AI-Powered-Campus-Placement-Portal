# PlaceIT AI service - copy to `.env` (git-ignored). Never commit real values.

# "production" makes the service refuse to run without AI_SERVICE_API_KEY
APP_ENV=development

# Shared secret: the Express backend sends it as the X-Internal-Key header.
# Must match AI_SERVICE_API_KEY in backend/.env.
AI_SERVICE_API_KEY=dev-only-change-me

# LLM provider (only "gemini" is implemented). Get a key from Google AI Studio.
LLM_PROVIDER=gemini
LLM_API_KEY=replace_with_your_gemini_api_key
# Check Google's current model list and free-tier limits before choosing.
LLM_MODEL=gemini-3.8-flash
# Backup models, tried in order if the main one is overloaded (503), rate-limited (429) or retired (404).
# Use names from YOUR key's model list that passed a test call.
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=30

# Hosts /parse-resume may download from (comma-separated, wildcard prefix allowed).
# Cloudinary and *.supabase.co are always allowed; add others here.
ALLOWED_FILE_HOSTS=

# Browsers should never call this service directly; CORS is only for local debugging.
CORS_ORIGINS=http://localhost:5000,http://localhost:5173
