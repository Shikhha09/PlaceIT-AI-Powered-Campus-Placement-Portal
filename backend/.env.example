# ─────────────────────────────────────────────────────────────────────────────
# LEAVE OPTIONAL SERVICES BLANK to switch them off (resume files then save to ./uploads,
# emails/WhatsApp print to the console, Google login is hidden). Fill them in only when
# you have real credentials.
# PlaceIT backend - copy to `.env` and fill in. NEVER put real values in this file
# (it is committed to git). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# MongoDB. Local default below works if MongoDB is running on your machine.
# For Atlas use: mongodb+srv://<user>:<password>@<your-cluster>.mongodb.net/campus_placement
MONGO_URI=mongodb://127.0.0.1:27017/campus_placement

# JWT
JWT_SECRET=dev_only_change_me_before_deploying
JWT_EXPIRE=7d
REFRESH_TOKEN_SECRET=dev_only_change_me_too
REFRESH_TOKEN_EXPIRE=30d

# Cloudinary (get from cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Supabase Storage (for resume uploads)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=resumes

# Email (SMTP - use a Gmail App Password or Mailtrap for dev)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Twilio WhatsApp (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SERVER_URL=http://localhost:5000

# ── AI service ───────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Shared secret between this backend and the FastAPI service. MUST match
# AI_SERVICE_API_KEY in ai-service/.env. Required in production.
AI_SERVICE_API_KEY=dev-only-change-me

# AI Career Copilot limits (per student)
COPILOT_RATE_PER_MIN=8
COPILOT_DAILY_CAP=40

# Client URL (CORS)
CLIENT_URL=http://localhost:5173
